# SBCMS Environment Configuration Example
# Copy this file to .env and configure details before booting

# --- Swiftbase Platform connection settings ---
SWIFTBASE_PROJECT_ID=your-project-id
SWIFTBASE_BASE_URL=https://api.swiftbase.io
SWIFTBASE_SERVICE_ID=your-service-identity-id
SWIFTBASE_SERVICE_KEY=your-service-identity-secret-key
SWIFTBASE_DATABASE_NAME=cms
SWIFTBASE_STORAGE_BUCKET=cms-site-assets

# --- AI and Layout Generator settings ---
SWIFTBASE_AI_KEY=your-swiftbase-ai-api-key

# --- Stripe Payments and Webhooks ---
STRIPE_SECRET_KEY=sk_test_...

# --- Server Configs ---
PORT=3000
COOKIE_SECRET=use-a-secure-random-phrase-here
